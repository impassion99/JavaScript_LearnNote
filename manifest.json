{
  "manifest_version": 3,
  "name": "Hello World Extension",
  "version": "1.1",
  "description": "Hello World triggered by hotkey",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["notifications"],   
  "commands": {
      "say-hello": {
        "suggested_key": {
          "default": "Ctrl+Shift+Y"
        },
        "description": "Say Hello World"
      }
    }
  }
